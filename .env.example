# Supabase (ブラウザにも送られる公開値)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key または legacy の anon key>

# サーバーだけで使う値。パイプラインから POST /api/revalidate するときのシークレット
REVALIDATE_SECRET=<openssl rand -hex 24 などで作った値>

# 見た目の版。cover = 書影あり (既定) / nocover = 書影なし (あらすじ型)。ビルド時に埋め込まれる
NEXT_PUBLIC_UI_VARIANT=cover
